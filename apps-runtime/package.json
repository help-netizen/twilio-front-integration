{
  "name": "@albusto/apps-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated runner for hand-authored Albusto App Studio applications",
  "main": "src/runner.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --no-node-snapshot src/server.js",
    "run:cli": "node --no-node-snapshot src/cli.js",
    "test": "node --no-node-snapshot node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "isolated-vm": "6.0.2"
  },
  "devDependencies": {
    "jest": "30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "restoreMocks": true
  }
}
