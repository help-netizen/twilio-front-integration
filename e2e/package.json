{
  "name": "albusto-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Albusto CRM pre-deploy E2E regression suite (Playwright) — see docs/specs/E2E-REGRESSION-001.md",
  "scripts": {
    "test": "playwright test",
    "smoke": "playwright test --grep @p0",
    "full": "playwright test",
    "headed": "playwright test --headed",
    "ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
