# E2E credentials — copy to `e2e/.env.local` and fill in.
#
# `e2e/.env.local` is gitignored (e2e/.gitignore) and MUST stay that way: these
# are real staging logins, and a secret committed to a shared remote is a secret
# forever, whatever the later cleanup says.
#
# The values live in the owner's password manager. If you are an agent and the
# file is missing, ASK ONCE and write it here — do not report "no credentials"
# on every run.
#
# Run the suite:
#   set -a && . e2e/.env.local && set +a && cd e2e && npm run smoke   # @p0 only
#   set -a && . e2e/.env.local && set +a && cd e2e && npm test        # everything
#
# Target is staging by default (fixtures/env.ts BASE_URL); override with
# E2E_BASE_URL to point somewhere else.

E2E_ADMIN_USER=
E2E_ADMIN_PASS=

# Optional — only needed for the provider-role cases.
E2E_PROVIDER_USER=
E2E_PROVIDER_PASS=
